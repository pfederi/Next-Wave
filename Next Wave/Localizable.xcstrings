    "Recommended wetsuit thickness in millimeters based on water temperature and wind chill. If air + water temp < 30°C, one size thicker is recommended (e.g. 3/2mm, 4/3mm)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empfohlene Neoprenanzug-Dicke in Millimetern basierend auf Wassertemperatur und gefühlter Kälte. Wenn Luft- + Wassertemperatur < 30 °C, wird eine Stufe dicker empfohlen (z. B. 3/2mm, 4/3mm)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Épaisseur de combinaison recommandée en millimètres selon la température de l'eau et la sensation de froid. Si température air + eau < 30 °C, une épaisseur supérieure est recommandée (p. ex. 3/2mm, 4/3mm)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spessore della muta consigliato in millimetri in base alla temperatura dell'acqua e alla sensazione di freddo. Se temperatura aria + acqua < 30 °C, si consiglia uno spessore maggiore (es. 3/2mm, 4/3mm)"
          }
        }
      }
    },
