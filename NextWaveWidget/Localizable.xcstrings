    },
    "Add favorite ferry stations to see departure times and schedules": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge favorisierte Schiffsstationen hinzu, um Abfahrtszeiten und Fahrpläne zu sehen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des stations de bateau favorites pour voir les heures de départ et les horaires"
