    "Verified badges come from your Foilmotion sessions. Record a session in Foilmotion, then share the GPX file to Next Wave." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Verifizierte Badges stammen aus deinen Foilmotion-Sessions. Zeichne eine Session in Foilmotion auf und teile dann die GPX-Datei mit Next Wave." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les Badges vérifiés proviennent de vos sessions Foilmotion. Enregistrez une session dans Foilmotion, puis partagez le fichier GPX avec Next Wave." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "I Badge verificati provengono dalle tue sessioni Foilmotion. Registra una sessione in Foilmotion, poi condividi il file GPX con Next Wave." } }
      }
    },
    "Open Foilmotion →" : {
