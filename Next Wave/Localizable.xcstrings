    },
    "Wetsuit Thickness" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Neoprenanzug-Dicke" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Épaisseur de la combinaison" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Spessore della muta" } }
      }
    },
    "Recommended wetsuit thickness in millimeters based on water temperature and wind chill. If air + water temp < 30°C, one size thicker is recommended (e.g. 3/2mm, 4/3mm)" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Empfohlene Neoprenanzug-Dicke in Millimetern basierend auf Wassertemperatur und gefühlter Kälte. Wenn Luft- + Wassertemperatur < 30 °C, wird eine Stufe dicker empfohlen (z. B. 3/2mm, 4/3mm)" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Épaisseur de combinaison recommandée en millimètres selon la température de l'eau et la sensation de froid. Si température air + eau < 30 °C, une épaisseur supérieure est recommandée (p. ex. 3/2mm, 4/3mm)" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Spessore della muta consigliato in millimetri in base alla temperatura dell'acqua e alla sensazione di freddo. Se temperatura aria + acqua < 30 °C, si consiglia uno spessore maggiore (es. 3/2mm, 4/3mm)" } }
      }
    },
    "Wind Speed & Direction" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Windgeschwindigkeit & -richtung" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vitesse et direction du vent" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Velocità e direzione del vento" } }
      }
    },
    "Wind speed in knots (kn) and wind direction (N, NE, E, SE, S, SW, W, NW)" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Windgeschwindigkeit in Knoten (kn) und Windrichtung (N, NE, E, SE, S, SW, W, NW)" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vitesse du vent en nœuds (kn) et direction du vent (N, NE, E, SE, S, SW, W, NW)" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Velocità del vento in nodi (kn) e direzione del vento (N, NE, E, SE, S, SW, W, NW)" } }
      }
    },
    "Night Time" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nachtzeit" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Période nocturne" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Ora notturna" } }
      }
    },
    "Departure is before sunrise or after sunset. Moon icon indicates full darkness, moon with stars indicates twilight (dusk/dawn)" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Abfahrt liegt vor Sonnenaufgang oder nach Sonnenuntergang. Das Mond-Symbol zeigt völlige Dunkelheit an, der Mond mit Sternen zeigt Dämmerung an (Abend-/Morgendämmerung)" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le départ a lieu avant le lever ou après le coucher du soleil. L'icône de lune indique l'obscurité totale, la lune avec des étoiles indique le crépuscule (aube/crépuscule)" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "La partenza avviene prima dell'alba o dopo il tramonto. L'icona della luna indica buio totale, la luna con le stelle indica il crepuscolo (alba/tramonto)" } }
      }
    },
    "Water Level" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wasserpegel" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Niveau d'eau" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Livello dell'acqua" } }
      }
    },
    "Difference from average water level in centimeters. Arrow up (↑) indicates higher water level, arrow down (↓) indicates lower water level (only shown for today)" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Abweichung vom durchschnittlichen Wasserpegel in Zentimetern. Pfeil nach oben (↑) zeigt höheren Wasserpegel, Pfeil nach unten (↓) zeigt niedrigeren Wasserpegel (nur für heute angezeigt)" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Écart par rapport au niveau d'eau moyen en centimètres. La flèche vers le haut (↑) indique un niveau d'eau plus élevé, la flèche vers le bas (↓) indique un niveau d'eau plus bas (affiché uniquement pour aujourd'hui)" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Differenza rispetto al livello medio dell'acqua in centimetri. La freccia verso l'alto (↑) indica un livello dell'acqua più alto, la freccia verso il basso (↓) indica un livello dell'acqua più basso (mostrato solo per oggi)" } }
      }
    },
