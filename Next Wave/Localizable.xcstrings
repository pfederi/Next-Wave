          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cas d'arrêt d'urgence, le capitaine doit mettre le navire en marche arrière. Cela crée une forte aspiration de l'hélice qui peut être extrêmement dangereuse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In caso di arresto di emergenza, il capitano deve mettere la nave in retromarcia. Questo crea una forte aspirazione dall'elica che può essere estremamente pericolosa."
          }
        }
      }
    },
