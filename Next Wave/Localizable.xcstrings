    "Departure is before sunrise or after sunset. Moon icon indicates full darkness, moon with stars indicates twilight (dusk/dawn)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Abfahrt liegt vor Sonnenaufgang oder nach Sonnenuntergang. Das Mond-Symbol zeigt völlige Dunkelheit an, der Mond mit Sternen zeigt Dämmerung an (Abend-/Morgendämmerung)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le départ a lieu avant le lever ou après le coucher du soleil. L'icône de lune indique l'obscurité totale, la lune avec des étoiles indique le crépuscule (aube/crépuscule)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La partenza avviene prima dell'alba o dopo il tramonto. L'icona della luna indica buio totale, la luna con le stelle indica il crepuscolo (alba/tramonto)"
          }
        }
      }
    },
    "Difference from average water level in centimeters. Arrow up (↑) indicates higher water level, arrow down (↓) indicates lower water level (only shown for today)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abweichung vom durchschnittlichen Wasserpegel in Zentimetern. Pfeil nach oben (↑) zeigt höheren Wasserpegel, Pfeil nach unten (↓) zeigt niedrigeren Wasserpegel (nur für heute angezeigt)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écart par rapport au niveau d'eau moyen en centimètres. La flèche vers le haut (↑) indique un niveau d'eau plus élevé, la flèche vers le bas (↓) indique un niveau d'eau plus bas (affiché uniquement pour aujourd'hui)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Differenza rispetto al livello medio dell'acqua in centimetri. La freccia verso l'alto (↑) indica un livello dell'acqua più alto, la freccia verso il basso (↓) indica un livello dell'acqua più basso (mostrato solo per oggi)"
          }
        }
      }
    },
