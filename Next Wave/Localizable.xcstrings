    "Display announcements and updates on home screen" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ankündigungen und Updates auf dem Startbildschirm anzeigen" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Afficher les annonces et mises à jour sur l'écran d'accueil" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Mostra annunci e aggiornamenti nella schermata principale" } }
      }
    },
    "Reset Dismissed Tiles" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ausgeblendete Kacheln zurücksetzen" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Réinitialiser les tuiles masquées" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Ripristina i riquadri nascosti" } }
      }
    },
    "Show all promo tiles again that you dismissed" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Alle von dir ausgeblendeten Promo-Kacheln wieder anzeigen" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Réafficher toutes les tuiles promo que vous avez masquées" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Mostra di nuovo tutti i riquadri promozionali che hai nascosto" } }
