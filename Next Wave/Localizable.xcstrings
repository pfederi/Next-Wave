      }
    },
    "Not enough waves in this time period for a good surf session. A good session needs at least 3 waves within a reasonable time frame." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nicht genügend Waves in diesem Zeitraum für eine gute Surf-Session. Eine gute Session benötigt mindestens 3 Waves innerhalb eines angemessenen Zeitraums." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Pas assez de Waves dans cette période pour une bonne session de surf. Une bonne session nécessite au moins 3 Waves dans un délai raisonnable." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Non ci sono abbastanza Wave in questo periodo per una buona sessione di surf. Una buona sessione richiede almeno 3 Wave in un lasso di tempo ragionevole." } }
      }
    },
    "Best Surf Sessions" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Beste Surf-Sessions" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Meilleures sessions de surf" } },
