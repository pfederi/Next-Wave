      }
    },
    "Flip device 180° in departure view to filter for best waves (Zürichsee)" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Gerät in der Abfahrtsansicht um 180° drehen, um nach den besten Waves zu filtern (Zürichsee)" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Retournez l'appareil à 180° dans la vue des départs pour filtrer les meilleures Waves (Zürichsee)" } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Capovolgi il dispositivo di 180° nella vista partenze per filtrare le Waves migliori (Zürichsee)" } }
      }
    },
    "Show Promo Tiles" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Promo-Kacheln anzeigen" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Afficher les tuiles promo" } },
