    "You can have a maximum of %lld favorite spots. Please remove one before adding another." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst maximal %lld Favoriten haben. Bitte entferne einen, bevor du einen weiteren hinzufügst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez avoir un maximum de %lld favoris. Veuillez en supprimer un avant d'en ajouter un autre."
