    "Be respectful to other water users" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei rücksichtsvoll gegenüber anderen Wassernutzern"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soyez respectueux envers les autres usagers de l'eau"
