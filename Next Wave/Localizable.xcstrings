      }
    },
    "Before you start catching waves, please read these important wakethieving rules for your safety and to preserve access to this amazing sport." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor du beginnst, Waves zu fangen, lies bitte diese wichtigen Wakethieving-Regeln zu deiner Sicherheit und um den Zugang zu diesem großartigen Sport zu bewahren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant de commencer à attraper des Waves, veuillez lire ces règles importantes de Wakethieving pour votre sécurité et pour préserver l'accès à ce sport formidable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di iniziare a prendere le Wave, leggi queste importanti regole di Wakethieving per la tua sicurezza e per preservare l'accesso a questo fantastico sport."
          }
        }
      }
    },
